<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sivaKartica">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/temnoModra"
        android:orientation="vertical"
        android:padding="24dp">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/dodaj_strosek_naslov"
          android:textColor="@color/bela"
          android:textSize="20sp"
          android:textStyle="bold" />

    </LinearLayout>

    <!-- KARTICA: FORMA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bela"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp">

      <!-- ZNESEK -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/dodaj_strosek_znesek"
          android:textColor="@color/besediloSivo"
          android:textSize="14sp" />

      <EditText
          android:id="@+id/et_znesek"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="@string/znesek_hint"
          android:inputType="numberDecimal"
          android:textSize="16sp"
          android:padding="12dp"
          android:layout_marginTop="6dp"
          android:background="@color/sivaKartica" />

      <!-- KATEGORIJA -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/dodaj_strosek_kategorija"
          android:textColor="@color/besediloSivo"
          android:textSize="14sp"
          android:layout_marginTop="16dp" />

      <!-- VRSTICA 1 -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_hrana"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/kat_hrana"
            android:textSize="11sp"
            android:maxLines="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/sivaKartica"
            android:textColor="@color/besediloTemno" />

        <Button
            android:id="@+id/btn_kava"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/kat_kava"
            android:textSize="11sp"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/sivaKartica"
            android:textColor="@color/besediloTemno" />

        <Button
            android:id="@+id/btn_prevoz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/kat_prevoz"
            android:textSize="11sp"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/sivaKartica"
            android:textColor="@color/besediloTemno" />

      </LinearLayout>

      <!-- VRSTICA 2 -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_stanovanje"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/kat_stanovanje"
            android:textSize="11sp"
            android:maxLines="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/sivaKartica"
            android:textColor="@color/besediloTemno" />

        <Button
            android:id="@+id/btn_tehnologija"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/kat_tehnologija"
            android:textSize="11sp"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/sivaKartica"
            android:textColor="@color/besediloTemno" />

        <Button
            android:id="@+id/btn_drugo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/kat_drugo"
            android:textSize="11sp"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/sivaKartica"
            android:textColor="@color/besediloTemno" />

      </LinearLayout>

      <!-- OPIS -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/dodaj_strosek_opis_label"
          android:textColor="@color/besediloSivo"
          android:textSize="14sp"
          android:layout_marginTop="16dp" />

      <EditText
          android:id="@+id/et_opis"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="@string/dodaj_strosek_opis_hint"
          android:textSize="16sp"
          android:padding="12dp"
          android:layout_marginTop="6dp"
          android:background="@color/sivaKartica" />

      <!-- GUMB DODAJ -->
      <Button
          android:id="@+id/btn_dodaj"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/poraba_dodaj_strosek"
          android:textSize="16sp"
          android:textColor="@color/bela"
          android:backgroundTint="@color/temnoModra"
          android:layout_marginTop="24dp"
          android:padding="14dp" />

      <!-- GUMB PREKLIČI -->
      <Button
          android:id="@+id/btn_preklici"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/gumb_preklici"
          android:textSize="16sp"
          android:textColor="@color/besediloSivo"
          android:backgroundTint="@android:color/transparent"
          android:layout_marginTop="8dp" />

    </LinearLayout>

  </LinearLayout>

</ScrollView>