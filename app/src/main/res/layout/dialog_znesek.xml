<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bela"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_dialog_naslov"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/besediloTemno"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_dialog_znesek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="0.00"
        android:inputType="numberDecimal"
        android:textSize="16sp"
        android:padding="12dp"
        android:layout_marginTop="16dp"
        android:background="@color/sivaKartica" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btn_dialog_preklici"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/gumb_preklici"
            android:textSize="14sp"
            android:backgroundTint="@color/sivaKartica"
            android:textColor="@color/besediloTemno"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_dialog_potrdi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/gumb_potrdi"
            android:textSize="14sp"
            android:backgroundTint="@color/zelena"
            android:textColor="@color/bela"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>