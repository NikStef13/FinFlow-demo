<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sivaKartica">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/zelena"
            android:orientation="horizontal"
            android:padding="24dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cilji_naslov"
                    android:textColor="@color/bela"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_skupni_cilji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="€0.00"
                    android:textColor="@color/bela"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tv_skupni_cilji_opis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cilji_skupni_opis"
                    android:textColor="@color/bela"
                    android:textSize="16sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/chart_skupni_cilji"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginStart="16dp" />

        </LinearLayout>

        <!-- KARTICA: DODAJ NOV CILJ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bela"
            android:orientation="horizontal"
            android:padding="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cilji_dodaj_nov_cilj"
                android:textColor="@color/besediloTemno"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_dodaj_cilj"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+"
                android:textSize="20sp"
                android:padding="0dp"
                android:backgroundTint="@color/zelena"
                android:textColor="@color/bela" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_cilji_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>