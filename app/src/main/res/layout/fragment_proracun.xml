<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sivaKartica">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/temnoModra"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upravljanje proračuna"
                android:textColor="@color/bela"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spremljajte svojo mesečno porabo"
                android:textColor="@color/bela"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- KARTICA: MESEČNI LIMIT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bela"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mesečni limit"
                    android:textColor="@color/besediloSivo"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btn_uredi_limit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_uredi"
                    android:backgroundTint="@android:color/transparent"
                    android:tint="@color/besediloSivo"
                    android:contentDescription="Uredi limit" />

            </LinearLayout>

            <!-- PRIKAZ LIMITA -->
            <TextView
                android:id="@+id/tv_limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="€0.00"
                android:textColor="@color/besediloTemno"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <!-- VNOSNO POLJE (privzeto skrito) -->
            <LinearLayout
                android:id="@+id/layout_vnos_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_limit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="500"
                    android:inputType="numberDecimal"
                    android:textSize="16sp"
                    android:padding="10dp"
                    android:background="@color/sivaKartica" />

                <Button
                    android:id="@+id/btn_potrdi_limit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="✓"
                    android:textSize="16sp"
                    android:padding="0dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/zelena"
                    android:textColor="@color/bela" />

                <Button
                    android:id="@+id/btn_preklici_limit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="✗"
                    android:textSize="16sp"
                    android:padding="0dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="@color/sivaKartica"
                    android:textColor="@color/besediloTemno" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Porabljeno"
                    android:textColor="@color/besediloSivo"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_odstotek"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/zelena"
                    android:textSize="13sp" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/pb_proracun"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:progress="0"
                android:max="100"
                android:progressTint="@color/zelena"
                android:progressBackgroundTint="@color/sivaKartica" />

            <!-- PORABLJENO / PREOSTALO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@color/sivaKartica"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Porabljeno"
                        android:textColor="@color/besediloSivo"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_porabljeno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="€0.00"
                        android:textColor="@color/besediloTemno"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@color/svetloZelena"
                    android:padding="12dp"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preostalo"
                        android:textColor="@color/besediloSivo"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_preostalo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="€0.00"
                        android:textColor="@color/zelena"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- KARTICA: NASVETI ZA VARČEVANJE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bela"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nasveti za varčevanje"
                android:textColor="@color/besediloTemno"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/sivaKartica"
                android:padding="12dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zmanjšajte stroške za kavo"
                    android:textColor="@color/besediloTemno"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pripravite kavo doma namesto v kavarni"
                    android:textColor="@color/besediloSivo"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/sivaKartica"
                android:padding="12dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Načrtujte nakupe"
                    android:textColor="@color/besediloTemno"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Naredite seznam pred obiskom trgovine"
                    android:textColor="@color/besediloSivo"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/sivaKartica"
                android:padding="12dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uporabite javni prevoz"
                    android:textColor="@color/besediloTemno"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prihranite pri stroških za gorivo"
                    android:textColor="@color/besediloSivo"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>