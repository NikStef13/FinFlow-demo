<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bela"
    android:padding="20dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_cilj_naslov"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/besediloTemno"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cilj_kategorija"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/besediloSivo"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="@string/moznosti" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tv_cilj_znesek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/besediloSivo"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_cilj_odstotek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/zelena"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_cilj"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="10dp"
        android:progress="0"
        android:max="100"
        android:progressTint="@color/zelena"
        android:progressBackgroundTint="@color/sivaKartica" />

    <TextView
        android:id="@+id/tv_cilj_preostalo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/besediloSivo"
        android:textSize="14sp"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btn_cilj_odbij"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cilj_gumb_odbij_item"
            android:textSize="15sp"
            android:padding="12dp"
            android:backgroundTint="@color/sivaKartica"
            android:textColor="@color/besediloTemno"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_cilj_dodaj"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cilj_gumb_dodaj_item"
            android:textSize="15sp"
            android:padding="12dp"
            android:backgroundTint="@color/zelena"
            android:textColor="@color/bela"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>